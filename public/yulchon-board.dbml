Project yulchon_board {
  database_type: 'SQLServer'
  Note: '''
  율촌 공식 사이트 - Board(소식/자료) 관계도 (YULCHON_2020)
  - DB에 실제 FK 제약 없음. Ref는 SP/매퍼 코드 근거의 논리적 관계
  - 회색 헤더 = Admin 관계도에 속한 테이블(여기서는 연결 지점만 표시)
  - 근거 SP: uspSetBoardContentsInsert, uspSetBoardContentsInsertMoveCustomized2,
    uspSetBoardContentsDelete, uspSetBoardContentsDeleteNew, uspGetBoardContentListSearchNew,
    uspGetBoardContentListSearchNewWorkPart, uspGetBoardContentListFront, uspGetBoardContentBoardID,
    uspGetHightlightList, uspGetWorkPartBoardList, uspGetAdminListPFBoard,
    uspSetBoardContentsUpdate, uspSetBoardAdminInsert/Delete, uspSetWorkPartBoardInsert/Delete,
    uspGetBoardContentListFrontDel, uspGetBoardContentListFrontLog, uspSetProfessionalDelete
  - 근거 매퍼: NewsAdminMapper.xml, ProfessionalBoardMapper.xml, ProfessionalAdminMapper.xml, MaintenanceToolMapper.xml
  '''
}

// =========================================================
// 1. 게시물 본체
// =========================================================

Table BoardContent [headercolor: #1E69FD] {
  BoardID int [pk, increment]
  BoardType int [note: '1 업무사례 / 2 소식 / 3 언론보도 / 4 뉴스레터 / 5 최신법률정보 / 6 논문저서 / 7 영상. Common(CExplain = "BoardType").CValue']
  Status tinyint [note: '0 임시본 / 1 공개본 / 2 삭제 표시 / 3 삭제 확정. 목록 SP는 1만 노출. 수정 SP는 파라미터 값으로 덮어씀. 글 주인 구성원 삭제 시 2']
  ViewYN tinyint [note: '1 노출. 구성원 경로 저장 시 1 고정']
  Highlight tinyint [note: '1 하이라이트(메인 노출). DeleteNew 삭제 시 2로 변경']
  HighlightSeq int [note: '하이라이트 순서. 등록: Highlight 1이면 Max + 1, 아니면 NULL. 수정: Highlight 1이면 기존 값 유지(없으면 Max + 1), 아니면 0. 즉 NULL과 0 모두 "없음"']
  TopNotice tinyint [note: '상단 고정 순서. NULL이면 정렬 시 100 취급']
  CreateDate smalldatetime [note: '화면 입력값(char(10))으로 저장. 목록 기간 검색/정렬 기준']
  AuthorYY smalldatetime [note: '논문저서(6) 저작연도. 6은 이 값으로 기간 검색/정렬. 빈 값이면 CreateDate (등록·수정 모두, 검색엔진이 이 값 기준)']
  AdminID int [note: '글 주인 (Admin). 등록 때만 저장, 수정 SP에서 바뀌지 않음']
  AdminName nvarchar(50) [note: '작성자 이름 비정규화 (검색 SearchType 3). 등록 때만 저장, 이후 Admin 이름이 바뀌어도 그대로']
  Subject nvarchar(1000)
  Contents ntext
  GubunPart nvarchar(50) [note: '소식/간행물 구분값. "구분없음"이면 하이라이트 목록에서 제외']
  GubunContents tinyint
  BusinessType nvarchar(2000)
  BusinessPart nvarchar(2000) [note: '목록 검색 조건(@BusinessPart)']
  BusinessPersonPart nvarchar(2000)
  MatterCode nvarchar(500) [note: '업무사례 코드 (검색 SearchType 6)']
  Keywords nvarchar(2000)
  SearchKeyword ntext
  WriterDuo tinyint [note: '논문저서 공저 여부로 추정']
  PaperPrintCompany nvarchar(100) [note: '논문저서 출판사']
  OldBoardID int [note: '임시본 → 공개본. 승인(MoveCustomized2) 때 임시본 행에 공개본 BoardID 기록. 미승인 임시본은 NULL']
  OriginBoardID int [note: '언어 복사본 → 원본 임시본. 원본이면 NULL(-1 입력)']
  CopyYN tinyint [note: '언어 복사(copy) 체크 여부']
  Note: '''
  모든 게시판 글을 BoardType으로 구분해 한 테이블에 저장. 언어 컬럼은 없고 BoardLanguageRelation으로 언어를 정함.
  UpdateDate 컬럼 없음 (등록/수정 SP 모두 수정일을 남기지 않음 → 수정일 추적 불가).
  - 승인 반영(MoveCustomized2)이 SearchKeyword, CopyYN, MatterCode, OriginBoardID, PdfContentsFile을 공개본에 복사하지 않음
  - 소프트 삭제(Status = 2)만 하고 연결 테이블은 그대로 남음
  - uspSetBoardContentsDelete: BoardID 또는 OldBoardID = @BoardID 인 행을 Status 2
  - uspSetBoardContentsDeleteNew: 같은 대상에 Highlight = 2까지 변경
  '''
}

Table BoardAdminRelations [headercolor: #1E69FD] {
  BAID int [pk, increment, note: '등록 순서. 연결 구성원 표시 순서(ORDER BY BAID)']
  BoardID int
  AdminID int
  CreateDate datetime [note: 'uspSetBoardAdminInsert가 값을 넣지 않음 (DB 기본값이 없으면 NULL). 승인 복사 때만 원본 값 복사']
  Note: '''
  게시물 ↔ 연결 구성원(공저자). 이름은 저장하지 않고 Admin.AdminName을 조인해서 표시 (Admin.Status 조건 없음 → 삭제된 구성원 이름도 표시됨).
  구성원 삭제(uspSetProfessionalDelete) 시 정리되지 않음. 이름은 목록의 AdminNames(검색 SearchType 2)로 사용.
  구성원 목록(uspGetBoardContentListFront)은 BoardAdminRelations를 INNER JOIN → 연결 구성원이 없으면 빠짐.
  관리자 목록의 AdminNames 서브쿼리는 BoardContent 전체 기준이라 연결이 없어도 행은 남음(필터 아님).
  구성원 경로 저장 시 글 주인을 항상 첫 번째로 등록(ProfessionalBoardService.insertExposures).
  수정 시 전체 삭제 후 재등록(uspSetBoardAdminDelete → Insert)
  '''
}

Table WorkPartBoardRelations [headercolor: #1E69FD] {
  WAID int [pk, increment, note: '표시 순서(ORDER BY WAID)']
  BoardID int
  WorkPartID int
  Note: '''
  게시물 ↔ 업무분야. 관리자 목록 SP에서 WorkPart가 INNER JOIN → 업무분야가 1개 이상 있어야 노출.
  WorkNames는 WorkPart.Status in (1, 10)만 이어 붙임.
  수정 시 전체 삭제 후 재등록(uspSetWorkPartBoardDelete → Insert)
  '''
}

Table BoardLanguageRelation [headercolor: #1E69FD] {
  BoardLanaguageRelationID int [pk, increment, note: '실제 컬럼명 오타 그대로']
  BoardID int
  LanguageID int
  Note: 'uspSetBoardContentsInsert가 @Lang(LCode)로 1건 자동 생성. 없으면 어느 언어 목록에도 안 나옴. 언어별로 다른 글(BoardID)을 만드는 구조'
}

// =========================================================
// 2. 코드 / 마스터
// =========================================================

Table Common [headercolor: #7C3AED] {
  CExplain nvarchar [note: '"BoardType" 행이 게시판 종류 코드표 (다른 CExplain 값은 미확인)']
  CValue int [note: 'BoardType 코드값']
  CType nvarchar [note: '게시판 이름. 목록 결과의 BoardName(CValue를 반환)']
  Note: 'BoardContent.BoardType = CValue AND CExplain = "BoardType". 목록 SP에서 INNER JOIN이라 코드표에 없는 BoardType 글은 목록에서 빠짐'
}

Table WorkPart [headercolor: #7C3AED] {
  WorkPartID int [pk, increment]
  WorkName nvarchar [note: '업무분야명(국문)']
  GroupYn int [note: '그룹 여부']
  GroupID int [note: '팀이면 상위 그룹 WorkPartID, 그룹이면 0']
  GroupType int
  Seq int
  Status int [note: '1 사용 (uspGetWorkPartBoardList), 10 = 의미 미확인 (목록 SP는 1, 10 사용)']
  CreateDate datetime
  Note: '업무분야(구성원 쪽에서는 전문분야). 상세 관계는 별도 WorkPart 정리 때 확장'
}

Table Language [headercolor: #7C3AED] {
  LanguageID int [pk, increment, note: '국문 = 2 (코드 곳곳에서 2 고정)']
  LCode char(2) [note: 'KO / EN / JA / ZH']
  LName nvarchar
}

// =========================================================
// 3. 레거시 (SP에서 주석 처리, 현재 미사용)
// =========================================================

Table Board [headercolor: #9CA3AF] {
  BoardID int [pk, increment]
  BoardName nvarchar(50)
  Status tinyint
  CreateDate datetime
  Note: 'uspSetBoardContentsInsert 주석에 남은 옛 게시판 마스터. 현재 등록 흐름에서 사용 안 함'
}

Table Highlight [headercolor: #9CA3AF] {
  BoardID int
  BoardType int
  Subject nvarchar
  Seq int
  Status tinyint
  Note: 'uspGetHightlightList 주석에 남은 옛 하이라이트 테이블. 현재는 BoardContent.Highlight / HighlightSeq 사용'
}

// =========================================================
// 4. 구성원 승인 이력 (논문저서 6 / 소식 7 탭)
// =========================================================

Table BoardContentLog [headercolor: #D97706] {
  AdminRequestID int
  BoardID int [note: '스냅샷 당시 BoardID']
  BoardType int
  AdminID int
  Status tinyint [note: '스냅샷 당시 Status (0, 1, 2 모두 저장)']
  Subject nvarchar(1000)
  OldBoardID int
  OriginBoardID int
  CopyYN tinyint
  CreateDate smalldatetime
  Note: '''
  승인/반려 시 그 구성원·BoardType·언어의 게시물 전체 스냅샷 (insertBoardContentLog).
  BoardContent 거의 전 컬럼을 복사하지만 MatterCode는 빠져 있음.
  이력 목록은 EditPart 6/7이고 이 테이블에 행이 있는 요청만 표시.
  이력 상세(uspGetBoardContentListFrontLog): AdminRequestID로 이 테이블 + 연결 Log 3종을 조회,
  업무분야명은 현재 WorkPart, 구성원명은 현재 Admin에서 가져옴 (이름은 스냅샷 아님).
  반려 건은 연결 Log가 없어 업무분야/구성원 이름이 비어 보임
  '''
}

Table BoardAdminRelationsLog [headercolor: #D97706] {
  AdminRequestID int
  BAID int
  BoardID int
  AdminID int
  CreateDate datetime
  Status tinyint [note: '당시 BoardContent.Status']
  Note: '승인 시에만 기록 (반려는 BoardContentLog만)'
}

Table WorkPartBoardRelationsLog [headercolor: #D97706] {
  AdminRequestID int
  BoardID int
  WorkPartID int
  WAID int
  Status tinyint [note: '당시 BoardContent.Status']
  Note: '승인 시에만 기록'
}

Table BoardLanguageRelationLog [headercolor: #D97706] {
  AdminRequestID int
  BoardLanaguageRelationID int
  BoardID int
  LanguageID int
  Status tinyint [note: '당시 BoardContent.Status']
  Note: '승인 시에만 기록'
}

// =========================================================
// 5. Admin 관계도와의 연결 지점 (상세는 admin.dbml)
// =========================================================

Table Admin [headercolor: #6B7280] {
  AdminID int [pk, increment]
  AdminKind int [note: '3 오피셜']
  AdminType int [note: '2 구성원. 소식(2) 관리자 목록에서 AdminKind 3 + AdminType 2 작성 글은 제외']
  Status int [note: '1 유효 / 2 삭제']
  AdminName nvarchar(50) [note: '연결 구성원 이름 표시에 사용']
  Note: '상세 컬럼은 admin.dbml'
}

Table AdminRequest [headercolor: #6B7280] {
  AdminRequestID int [pk, increment]
  AdminID int
  EditPart int [note: '6 논문저서 / 7 소식 (Board 관련)']
  RequestState int [note: '1 대기 / 2 반려 / 3 승인']
  LanguageID int
  Note: '상세 컬럼은 admin.dbml'
}

Table PFUpdate [headercolor: #6B7280] {
  AdminID int
  LanguageID int
  News datetime [note: '소식 탭 최종 저장일']
  Discussion datetime [note: '논문저서 탭 최종 저장일']
  Note: '구성원 경로로 게시물 저장 시 갱신 (copy 대상 언어 포함)'
}

Table PFCopy [headercolor: #6B7280] {
  AdminID int
  LanguageID int
  News int [note: '소식 copy 체크 여부']
  Discussion int [note: '논문저서 copy 체크 여부']
}

// =========================================================
// 관계
// =========================================================

// 게시물 본체
Ref: BoardContent.BoardType > Common.CValue
Ref: BoardContent.AdminID > Admin.AdminID
Ref: BoardContent.OldBoardID > BoardContent.BoardID
Ref: BoardContent.OriginBoardID > BoardContent.BoardID

// 연결 테이블
Ref: BoardAdminRelations.BoardID > BoardContent.BoardID
Ref: BoardAdminRelations.AdminID > Admin.AdminID
Ref: WorkPartBoardRelations.BoardID > BoardContent.BoardID
Ref: WorkPartBoardRelations.WorkPartID > WorkPart.WorkPartID
Ref: BoardLanguageRelation.BoardID > BoardContent.BoardID
Ref: BoardLanguageRelation.LanguageID > Language.LanguageID

// 업무분야 계층
Ref: WorkPart.GroupID > WorkPart.WorkPartID

// 승인 이력
Ref: BoardContentLog.AdminRequestID > AdminRequest.AdminRequestID
Ref: BoardAdminRelationsLog.AdminRequestID > AdminRequest.AdminRequestID
Ref: WorkPartBoardRelationsLog.AdminRequestID > AdminRequest.AdminRequestID
Ref: BoardLanguageRelationLog.AdminRequestID > AdminRequest.AdminRequestID
Ref: BoardContentLog.BoardID > BoardContent.BoardID

// Admin 쪽 연결
Ref: AdminRequest.AdminID > Admin.AdminID
Ref: AdminRequest.LanguageID > Language.LanguageID
Ref: PFUpdate.AdminID > Admin.AdminID
Ref: PFCopy.AdminID > Admin.AdminID

// =========================================================
// 그룹
// =========================================================

TableGroup board_core {
  BoardContent
  BoardAdminRelations
  WorkPartBoardRelations
  BoardLanguageRelation
}

TableGroup board_master {
  Common
  WorkPart
  Language
}

TableGroup board_legacy {
  Board
  Highlight
}

TableGroup board_approval_log {
  BoardContentLog
  BoardAdminRelationsLog
  WorkPartBoardRelationsLog
  BoardLanguageRelationLog
}

TableGroup admin_link {
  Admin
  AdminRequest
  PFUpdate
  PFCopy
}

// =========================================================
// 메모
// =========================================================

Note board_codes {
  '''
  BoardType: 1 업무사례 / 2 소식 / 3 언론보도 / 4 뉴스레터 / 5 최신법률정보 / 6 논문저서 / 7 영상
  BoardContent.Status: 0 임시본 / 1 공개본 / 2 삭제 표시 / 3 삭제 확정
  Highlight: 1 하이라이트 / 2 삭제됨(DeleteNew)
  검색 SearchType: 0 전체 / 1 제목 / 2 연결 구성원 / 3 작성자 / 4 내용 / 5 구분 / 6 MatterCode
  '''
}

Note board_list_rules {
  '''
  관리자 목록(uspGetBoardContentListSearchNew)에 나오려면
  - Status = 1, Common에 BoardType 코드 존재
  - BoardLanguageRelation에 해당 언어 행 존재
  - WorkPartBoardRelations 1개 이상 (WorkPart INNER JOIN)
  - 소식(2): 구성원(AdminKind 3, AdminType 2)이 쓴 글은 제외
  - 글 주인(AdminID)이 Admin에 존재
  구성원 목록(uspGetBoardContentListFront, FrontDel은 본문 동일)에 나오려면
  - AdminID = 본인, Status = 요청값, 해당 언어 BoardLanguageRelation 존재
  - BoardAdminRelations 1개 이상 (INNER JOIN)
  이력 목록(uspGetBoardContentListFrontLog)은 BoardContentLog 기준, 연결 Log는 LEFT JOIN
  '''
}

Note board_approval_flow {
  '''
  구성원 논문저서/소식 승인 (uspSetBoardContentsInsertMoveCustomized2)
  1. 구성원 저장 → 임시본(Status 0)
  2. 승인 시 OldBoardID 없음 → 공개본 새로 생성 + 임시본.OldBoardID 기록 + 연결 3종 복사
  3. OldBoardID 있음 → 공개본 내용 UPDATE + 연결 3종 삭제 후 재복사
  4. 삭제 표시(2) 임시본 → 공개본도 Status 2, 이후 임시본은 Status 3
  5. 임시본은 지워지지 않고 다음 수정의 작업본으로 남음
  '''
}


Ref: "WorkPartBoardRelationsLog"."AdminRequestID" ?<>? "WorkPartBoardRelationsLog"."WorkPartID"